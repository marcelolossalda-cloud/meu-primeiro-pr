{
  "manifest_version": 3,
  "name": "WA CRM Lite — CRM para WhatsApp Web",
  "version": "0.1.0",
  "description": "Adiciona um painel de CRM ao WhatsApp Web: notas, etiquetas, modelos de resposta, mensagens agendadas e lembretes de follow-up.",
  "default_locale": "pt_BR",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/lib/store.js",
        "src/content/wa-dom.js",
        "src/content/sidebar.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "WA CRM Lite"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/sidebar.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
